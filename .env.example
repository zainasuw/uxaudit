# Copy to .env for local use. Never commit .env.
GEMINI_API_KEY=
# Optional: model name (default gemini-3.5-flash-lite)
GEMINI_MODEL=
# The review instruction, as text (multi-line allowed) ...
REVIEW_INSTRUCTION=
# ... or the same text base64-encoded on one line (for hosts whose secrets are single-line) ...
REVIEW_INSTRUCTION_B64=
# ... or a path to a file containing it (local default: prompts/review-instruction.txt)
REVIEW_INSTRUCTION_FILE=
# Hosting only: public host name(s) this server answers for, comma-separated
ALLOWED_HOSTS=
# Hosting only: set to 1 behind a reverse proxy so rate limits see the real client address
TRUST_PROXY=
# Hosting only: set to 0 where the container cannot run the Chromium sandbox
CHROMIUM_SANDBOX=
